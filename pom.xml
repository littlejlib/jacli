<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.github.littlejlib</groupId>
    <artifactId>littlejlib-jacli</artifactId>
    <version>0.1</version>
    <packaging>jar</packaging>

    <description>jacli - java assist cli. Semantic code navigation (find usages, call hierarchy, type queries) over java/maven projects for AI coding agents, backed by an indexing daemon.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <main.class>littlejlib.jacli.JacliCli</main.class>
        <exec.mainClass>${main.class}</exec.mainClass>
        <datahelper.version>1.3</datahelper.version>
        <gson.version>2.14.0</gson.version>
        <picocli.version>4.7.7</picocli.version>
        <jsoup.version>1.22.2</jsoup.version>
        <jackson.version>2.21.2</jackson.version>
        <jgit.version>6.6.0.202305301015-r</jgit.version>
        <slf4j.version>2.0.18</slf4j.version>
        <cfr.version>0.152</cfr.version>
        <junit.version>5.11.4</junit.version>
        <surefire.version>3.5.4</surefire.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
            <version>${picocli.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.datapotter</groupId>
            <artifactId>datapotter-datahelper-annotations</artifactId>
            <version>1.1</version>
        </dependency>
        <dependency>
            <groupId>io.github.datapotter</groupId>
            <artifactId>datapotter-datahelper-base</artifactId>
            <version>${datahelper.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>${jsoup.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jgit</groupId>
            <artifactId>org.eclipse.jgit</artifactId>
            <version>${jgit.version}</version>
        </dependency>
        <!-- JGit drags in slf4j-api 1.7, which wins over the 2.x binding and makes
             every run print "Failed to load class StaticLoggerBinder". Pin the api to match. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.benf</groupId>
            <artifactId>cfr</artifactId>
            <version>${cfr.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>**/build-stamp.txt</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>**/build-stamp.txt</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
                <configuration>
                    <release>25</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>io.github.datapotter</groupId>
                            <artifactId>datapotter-datahelper-processor</artifactId>
                            <version>${datahelper.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>META-INF/DEPENDENCIES</exclude>
                                        <exclude>META-INF/LICENSE*</exclude>
                                        <exclude>META-INF/NOTICE*</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>project-classifier</shadedClassifierName>
                            <outputFile>shade\${project.artifactId}.jar</outputFile>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${main.class}</mainClass>
                                    <manifestEntries>
                                        <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                                        <Add-Opens>java.base/sun.nio.ch java.base/java.nio.channels.spi</Add-Opens>
                                        <Add-Exports>jdk.unsupported/sun.misc</Add-Exports>
                                    </manifestEntries>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- The cmdtools launcher(s), built by jr-maven-plugin with the config baked in (replaces the .jrc):
             mvn -Djrexe -Djr.installDir=<folder on PATH> package -->
    <profiles>
        <profile>
            <id>jrexe</id>
            <activation>
                <property>
                    <name>jrexe</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>io.github.jarrunner</groupId>
                        <artifactId>jr-maven-plugin</artifactId>
                        <version>1.3.0</version>
                        <configuration>
                            <jvmMode>dll</jvmMode>
                            <aot>true</aot>
                            <jar>${project.basedir}/shade/${project.artifactId}.jar</jar>
                            <vmArgs><vmArg>-Xlog:aot*=off</vmArg><vmArg>-XX:+UseSerialGC</vmArg></vmArgs>
                        </configuration>
                        <executions>
                            <execution>
                                <id>jacli</id>
                                <goals><goal>exe</goal></goals>
                                <configuration><name>jacli</name></configuration>
                            </execution>
                            <execution>
                                <id>daemon</id>
                                <goals><goal>exe</goal></goals>
                                <configuration>
                                    <name>jacli-daemon</name>
                                    <appArgs><appArg>serve-daemon</appArg></appArgs>
                                    <vmArgs>
                                        <vmArg>-Xms16m</vmArg>
                                        <vmArg>-Xmx1g</vmArg>
                                        <vmArg>-XX:+UseSerialGC</vmArg>
                                        <vmArg>-XX:MinHeapFreeRatio=10</vmArg>
                                        <vmArg>-XX:MaxHeapFreeRatio=30</vmArg>
                                        <vmArg>-XX:MaxMetaspaceSize=256m</vmArg>
                                        <vmArg>-XX:MaxDirectMemorySize=256m</vmArg>
                                        <vmArg>-XX:ReservedCodeCacheSize=96m</vmArg>
                                        <vmArg>-Xlog:aot*=off</vmArg>
                                    </vmArgs>
                                </configuration>
                            </execution>
                            <execution>
                                <id>symbols</id>
                                <goals><goal>exe</goal></goals>
                                <configuration><name>symbols</name></configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles></project>
